{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ScopeBridge closing workflow",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "backend": {
          "label": "Business logic"
        },
        "security": {
          "label": "Human review"
        },
        "database": {
          "label": "Persistence"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "main",
      "label": "Requirements and quoting"
    },
    {
      "id": "payment",
      "label": "Confirmation and payment"
    },
    {
      "id": "exception",
      "label": "Exceptions and changes",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "input",
      "lane": "main",
      "col": 0,
      "type": "frontend",
      "label": "Submit requirement",
      "width": 150
    },
    {
      "id": "clarify",
      "lane": "main",
      "col": 1,
      "type": "backend",
      "label": "AI clarification and proposals",
      "width": 230
    },
    {
      "id": "quote",
      "lane": "main",
      "col": 2,
      "type": "backend",
      "label": "Validate and choose option",
      "width": 200
    },
    {
      "id": "review",
      "lane": "main",
      "col": 3,
      "type": "security",
      "label": "Provider review",
      "width": 130
    },
    {
      "id": "confirm",
      "lane": "payment",
      "col": 3,
      "type": "frontend",
      "label": "Client confirms version",
      "width": 185
    },
    {
      "id": "checkout",
      "lane": "payment",
      "col": 4,
      "type": "external",
      "label": "Create, approve, capture",
      "width": 190
    },
    {
      "id": "paid",
      "lane": "payment",
      "col": 5,
      "type": "database",
      "label": "Verify and record paid",
      "width": 180
    },
    {
      "id": "change",
      "lane": "exception",
      "col": 2,
      "type": "backend",
      "label": "Revise and re-quote",
      "width": 160
    },
    {
      "id": "pending",
      "lane": "exception",
      "col": 4,
      "type": "backend",
      "label": "Cancel or unknown result",
      "width": 200
    }
  ],
  "edges": [
    {
      "id": "input-clarify",
      "from": "input",
      "to": "clarify",
      "label": "Extract",
      "role": "main"
    },
    {
      "id": "clarify-quote",
      "from": "clarify",
      "to": "quote",
      "label": "Information complete",
      "role": "main"
    },
    {
      "id": "quote-review",
      "from": "quote",
      "to": "review",
      "label": "Feasible option",
      "role": "main"
    },
    {
      "id": "review-confirm",
      "from": "review",
      "to": "confirm",
      "label": "Review passed",
      "role": "main"
    },
    {
      "id": "confirm-checkout",
      "from": "confirm",
      "to": "checkout",
      "label": "Confirm current version",
      "role": "main"
    },
    {
      "id": "checkout-paid",
      "from": "checkout",
      "to": "paid",
      "label": "Capture succeeded and verified",
      "role": "main"
    },
    {
      "id": "confirm-change",
      "from": "confirm",
      "to": "change",
      "label": "Change requested",
      "role": "branch"
    },
    {
      "id": "change-clarify",
      "from": "change",
      "to": "clarify",
      "label": "New version",
      "role": "branch"
    },
    {
      "id": "checkout-pending",
      "from": "checkout",
      "to": "pending",
      "label": "Cancel or timeout",
      "role": "branch"
    },
    {
      "id": "pending-checkout",
      "from": "pending",
      "to": "checkout",
      "label": "Recovered after query",
      "role": "branch"
    }
  ],
  "mainPath": [
    "input",
    "clarify",
    "quote",
    "review",
    "confirm",
    "checkout",
    "paid"
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Release conditions",
      "items": [
        "Missing fields are clarified first; no feasible solution goes to a human",
        "The client confirms after human review; the version is locked during payment"
      ]
    }
  ]
}
