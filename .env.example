# ScopeBridge environment template.
# Copy to `.env`, fill in real values. `.env` is git-ignored and never committed.

# --- Database ---------------------------------------------------------------
# Option A (default): container from docker-compose.yml
#   docker compose up -d
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgresql+psycopg://scopebridge:change-me-too@127.0.0.1:55433/scopebridge

# Option B: local PostgreSQL instead of the container
# DATABASE_URL=postgresql+psycopg://postgres:<password>@127.0.0.1:5432/scopebridge

# --- Application ------------------------------------------------------------
# Origin the browser uses. Cookie `Secure` is derived from this scheme.
APP_BASE_URL=http://127.0.0.1:5173
# 32+ random characters. Server-side session identifiers are stored as SHA-256 digests.
SESSION_SECRET=replace-with-32-random-characters

# --- Seller account (single operator, seeded on first start) -----------------
SELLER_EMAIL=seller@scopebridge.local
SELLER_PASSWORD=replace-with-a-strong-password

# --- Model provider (OpenAI-compatible; used from M3 onward) ----------------
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=
# Seconds before a model call is abandoned and reported as 502.
MODEL_TIMEOUT_SECONDS=60

# --- PayPal sandbox (used from M4 onward) -----------------------------------
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: reject a capture whose payee is not this merchant.
PAYPAL_MERCHANT_ID=
PAYPAL_TIMEOUT_SECONDS=30
